# Arch Linux package of the desktop app, built from this working tree
# (packaging/arch is two levels below the repository root).
#
#   paru -Bi --rebuild packaging/arch    # build and install
#   makepkg -sif                         # the same, from inside packaging/arch
#
# The version stays the same between builds of the tree, so force the build
# (--rebuild / -f); otherwise the package file of the last build is reused.

pkgname=quran-dx
pkgver=0.1.0
pkgrel=1
pkgdesc="The Noble Quran: a reader for the 15-line Madani mushaf"
arch=('x86_64')
url="https://quran.com"
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'xdotool' 'hicolor-icon-theme')
makedepends=('cargo')
# The release profile already does LTO and strips; no separate debug package.
options=('!lto' '!debug')

build() {
  cd "$startdir/../.."
  # Its own target directory: makepkg's RUSTFLAGS would otherwise invalidate the development build.
  CARGO_TARGET_DIR="$PWD/target/package" cargo build --release --locked -p quran-app
}

package() {
  cd "$startdir/../.."
  install -Dm755 target/package/release/quran-app "$pkgdir/usr/bin/quran-dx"
  install -Dm644 packaging/quran-dx.desktop "$pkgdir/usr/share/applications/quran-dx.desktop"
  install -Dm644 packaging/quran-dx.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/quran-dx.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/quran-dx/README.md"
}
